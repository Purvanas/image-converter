HOST=127.0.0.1
PORT=3400
# Facultatif : emplacement des uploads, statistiques et journaux runtime.
RUNTIME_DIR=
# Facultatif : laisse vide pour désactiver le mode administrateur.
ADMIN_CODE=
# Plafonds multipart globaux ; les limites propres à chaque format restent appliquées ensuite.
PUBLIC_UPLOAD_MAX_BYTES=524288000
ADMIN_UPLOAD_MAX_BYTES=2147483648
# Facultatif : Bearer token distinct pour lire les journaux techniques.
ERRORS_TOKEN=
# Facultatif : chemins explicites si les binaires ne sont pas dans PATH.
FFMPEG_BIN=
FFPROBE_BIN=
PDFTOPPM_BIN=
